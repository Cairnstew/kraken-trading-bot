# Kraken API credentials
KRAKEN_API_KEY=your_api_key_here
KRAKEN_API_SECRET=your_api_secret_here

# Optional: Override API URLs
# KRAKEN_REST_URL=https://api.kraken.com
# KRAKEN_WS_URL=wss://ws.kraken.com/v2
# KRAKEN_WS_AUTH_URL=wss://ws-auth.kraken.com/v2

# Optional: Rate limiting (seconds between REST calls)
# KRAKEN_MIN_INTERVAL=0.1

# Optional: Paper trading mode (simulates trades without real money)
# KRAKEN_PAPER_MODE=true
# KRAKEN_PAPER_BALANCE=10000
