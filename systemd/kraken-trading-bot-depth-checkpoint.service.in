[Unit]
Description=Copy the order-book depth log off this machine (G1 weekly checkpoint)
Documentation=file://@ROOT@/.data-audit/EVIDENCE-G1-DEPTH-RECORDER.md
# A weekly copy failing on auth is the exact failure the checkpoint-age check in
# `depth-gaps` exists to catch: it looks like a working recorder.
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=@ROOT@
# NO `depth-gaps` preflight here, and that is a measured correction.  A preflight
# was added first and it made the unit FAIL: `depth-gaps` exits 1 precisely when
# the checkpoint is stale, which is the condition this unit exists to repair — so
# the oneshot died before reaching the backup.  Same deadlock as in the recipe,
# one layer out.  `depth-backup-git` does its own `depth-gaps` read internally
# with `|| true`, and the backup itself is the validation.
# `depth-backup-git` is a JUST RECIPE, not a CLI subcommand — calling the
# CLI with it failed with `invalid choice: depth-backup-git`, exit 2.
ExecStart=@JUST@ --justfile @ROOT@/justfile --working-directory @ROOT@ depth-backup-git @REMOTE@
# Network or DNS down must be visible in the journal, not fatal to the boot.
SuccessExitStatus=0
# The credential is read from ~/.git-credentials via the gh credential helper,
# both under $HOME.  Pin HOME so a login-less unit still finds them.
Environment=HOME=@HOME@
TimeoutStartSec=300
