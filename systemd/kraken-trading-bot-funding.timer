# One timer only.  Hourly is the cadence the funding cadence needs:
# kraken-funding-rates settles HOURLY (measured: inter-record gap histogram
# {1.0h: 8783, 2.0h: 6, 3.0h: 1} over Kraken's own 8,791-record history —
# an earlier revision of this file asserted an eight-hour settlement
# cadence, wrong by 8x), and its snapshot also carries bid/ask and vol24h,
# which move between settlements, so an hourly pull is what keeps `spread`
# and `vol24h` non-stale.  It costs ~0.0003 calls/s.
#
# This timer is FORWARD-ONLY: it appends one snapshot per hour and nothing
# backfills.  `just funding-backfill` is what fills history (Kraken's own
# ~366-day window, which ages out, so run it periodically as a top-up).
#
# Installed/started by `just funding-timer`, or manually:
#   systemctl --user enable --now kraken-trading-bot-funding.timer
[Unit]
Description=Hourly Kraken funding snapshot pull for kraken-trading-bot

[Timer]
OnCalendar=*-*-* *:17:00
# Catch up after a suspend/lid-close instead of silently skipping hours.
Persistent=true
RandomizedDelaySec=120
Unit=kraken-trading-bot-funding.service

[Install]
WantedBy=timers.target